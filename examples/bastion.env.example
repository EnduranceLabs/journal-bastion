JOURNAL_BASTION_TOKEN=gw_demo
JOURNAL_BASTION_URL=ws://localhost:8080

# PostgreSQL example used by bastion.json.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=analytics
POSTGRES_USER=journal_bastion_ro
POSTGRES_PASSWORD=replace-me

# MySQL automatic integration (Docker image). Use this instead of the
# individual MYSQL_* fields below when a MySQL URL is more convenient.
# MYSQL_CONNECTION_STRING=mysql://journal_bastion_ro:replace-me@mysql.internal:3306/analytics

# Remote API example used by bastion.json.
# Include the full header value expected by the remote MCP server.
REMOTE_MCP_AUTHORIZATION=Bearer replace-me

# Grafana automatic integration (Docker image). The MCP server is yours to run;
# the token is the one it requires from callers, without the "Bearer " prefix.
# GRAFANA_MCP_URL=https://mcp-grafana.example.com/mcp
# GRAFANA_MCP_TOKEN=replace-me

# Temporal Cloud automatic integration (Docker image).
# Choose TEMPORAL_API_KEY or both PEM-encoded mTLS values.
# TEMPORAL_API_KEY=replace-me
# TEMPORAL_TLS_CERT_DATA=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----
# TEMPORAL_TLS_KEY_DATA=-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----
# TEMPORAL_NAMESPACE=your-namespace.a1b2c
# TEMPORAL_ADDRESS=your-namespace.a1b2c.tmprl.cloud:7233
